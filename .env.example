POSTGRES_DB=aurion_beta
POSTGRES_USER=aurion_beta
POSTGRES_PASSWORD=replace-with-a-long-random-password
AURION_DATABASE_URL=postgresql://aurion_beta:replace-with-a-long-random-password@database:5432/aurion_beta
AURION_GITHUB_CLIENT_ID=replace-with-github-app-or-oauth-client-id
AURION_GITHUB_CLIENT_SECRET=replace-with-github-app-or-oauth-client-secret
AURION_GITHUB_CALLBACK_URL=https://api.beta.example.com/auth/github/callback
AURION_FRONTEND_URL=https://beta.example.com
AURION_ALLOWED_ORIGINS=https://beta.example.com
AURION_SESSION_SECRET=replace-with-at-least-32-random-characters
AURION_RELEASE_SYNC_TOKEN=replace-with-a-different-32-character-random-secret
AURION_SESSION_COOKIE=aurion_beta_session
AURION_OAUTH_STATE_COOKIE=aurion_beta_oauth_state
AURION_COOKIE_SECURE=true
AURION_COOKIE_SAMESITE=lax
AURION_COOKIE_DOMAIN=.example.com
AURION_SESSION_TTL_SECONDS=43200
AURION_OAUTH_STATE_TTL_SECONDS=600
AURION_RELEASE_REPOSITORY=CatalystNexusLLC/aurion_beta_launcher
AURION_LAUNCHER_VERSION=0.2.1
AURION_LAUNCHER_TAG=v0.2.1
# Set only after the tagged launcher commit exists:
AURION_LAUNCHER_COMMIT_SHA=
AURION_TERMS_VERSION=AURION-BETA-TERMS-0.2.1
AURION_TERMS_SHA256=2bbbea4db70594425ddf95560c85b4c2ad8bbb35b533eee87ec07e8f67d2b317
AURION_PRIVACY_VERSION=AURION-PRIVACY-0.2.1
